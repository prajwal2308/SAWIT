# Shared secret. The Shortcut sends it as X-API-Key; browser views accept ?k=<key>.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SAWIT_API_KEY=

# --- Which model writes the notes ---
# "anthropic" (best quality) or "nvidia" (any OpenAI-compatible endpoint).
SAWIT_LLM=anthropic

# For SAWIT_LLM=anthropic
ANTHROPIC_API_KEY=

# For SAWIT_LLM=nvidia — free key from build.nvidia.com, starts with nvapi-
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Must be multimodal, or the on-screen numbers are lost. Set SAWIT_VISION=false
# if you pick a text-only model.
# SAWIT_MODEL=meta/llama-4-maverick-17b-128e-instruct
SAWIT_VISION=true
SAWIT_EMBED_MODEL=nvidia/nemotron-3-embed-1b

# Where notes live. On Fly/Railway point this at a mounted volume so a redeploy
# does not wipe your notes.
SAWIT_DB=/data/sawit.sqlite3

# Push. Pick a long random topic name — anyone who knows it can read your notes.
NTFY_TOPIC=sawit-CHANGE-THIS-a8f2c1
NTFY_SERVER=https://ntfy.sh

# Used to make the notification tappable. Set to your deployed URL.
PUBLIC_BASE_URL=

# Leave this empty first: public reels download without it, and then there is no
# session to leak. Only if a download hits a login wall, export cookies in
# Netscape format and mount the file here — from a THROWAWAY account, never your
# own. sessionid is a live login, so whoever holds the file is you. See README.
YTDLP_COOKIES_FILE=

# --- Transcription ---
# "faster-whisper" runs locally: free, but it is what forces a 2 GB machine.
# "hosted" calls any OpenAI-compatible transcription endpoint, which makes this
# service light enough for a small free tier.
SAWIT_ASR=faster-whisper
SAWIT_WHISPER_MODEL=small
# Only for SAWIT_ASR=hosted
ASR_BASE_URL=
ASR_API_KEY=
ASR_MODEL=whisper-1
SAWIT_FRAMES=4
SAWIT_MAX_DURATION=900

# --- Instagram DM ingestion (optional; the zero-friction path) ---
# Leave blank to run share-sheet-only. See README for the setup walkthrough.
IG_APP_SECRET=
IG_VERIFY_TOKEN=pick-any-random-string-and-paste-it-into-the-meta-console
IG_ACCESS_TOKEN=
# Bump when Meta deprecates a version; no code change needed.
IG_API_BASE=https://graph.instagram.com
IG_API_VERSION=v23.0
